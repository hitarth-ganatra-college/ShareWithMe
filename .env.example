# MongoDB Atlas Connection URI
# Replace with your Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sharewithme?retryWrites=true&w=majority

# NextAuth / Auth.js Configuration
AUTH_SECRET=generate_a_random_32_char_secret_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Credentials (Optional for local testing, required for Google sign-in)
# Obtain these from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
